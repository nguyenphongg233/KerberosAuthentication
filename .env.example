# Kerberos demo runtime config template.
# Copy this file to .env on each machine, then edit the host values.

KRB_REALM=DEMO.LOCAL
KRB_WIRE_FORMAT=der

# KDC server config.
# Local single-machine demo:
KDC_BIND_HOST=127.0.0.1
KDC_HOST=127.0.0.1
KDC_PORT=4321
#
# LAN demo on the KDC machine:
# KDC_BIND_HOST=0.0.0.0
# KDC_HOST=<KDC_LAN_IP>
#
# LAN demo on App Server / Client machines:
# KDC_BIND_HOST=127.0.0.1
# KDC_HOST=<KDC_LAN_IP>

# Application server config.
# Local single-machine demo:
APP_SERVER_BIND_HOST=127.0.0.1
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8000
APP_SERVICE_NAME=fileserver
APP_SERVER_NAME=localhost
#
# LAN demo on the App Server machine:
# APP_SERVER_BIND_HOST=0.0.0.0
# APP_SERVER_HOST=<APP_SERVER_LAN_IP>
# APP_SERVER_NAME=<APP_SERVER_LAN_IP_OR_HOSTNAME>
#
# LAN demo on KDC / Client machines:
# APP_SERVER_HOST=<APP_SERVER_LAN_IP>
# APP_SERVER_NAME=<same value used when creating/exporting the service keytab>

# Runtime files. For LAN, keep KDC_DB_PATH on the KDC machine, copy/export
# APP_SERVER_KEYTAB to the App Server machine, and keep KRB5CCNAME on clients.
KDC_DB_PATH=kdc/database.db
APP_SERVER_KEYTAB=app_server/fileserver.keytab
KRB5CCNAME=client/krb5cc_demo
KRB_REPLAY_CACHE=kdc/database.db

# KAdmin Web demo console.
KADMIN_WEB_HOST=127.0.0.1
KADMIN_WEB_PORT=8088

# Demo lockout policy.
KRB_AUTH_FAILURE_THRESHOLD=3
KRB_AUTH_LOCKOUT_SECONDS=300
